  "components": [
    {
      "name": "Region Tabs",
      "kind": "nav",
      "refersTo": "region-tab",
      "description": "Condensed-caps region selector on the sea-blue collar.",
      "html": "<nav class=\"ds-tabs\"><button aria-pressed=\"true\">Rata-rata DIY</button><button aria-pressed=\"false\">Sleman</button><button aria-pressed=\"false\">Bantul</button></nav>",
      "css": ".ds-tabs{display:flex;gap:2px;background:var(--collar,#12385a);padding:0 16px}.ds-tabs button{font-family:\"Archivo Variable\",system-ui,sans-serif;border:0;background:transparent;color:var(--collar-ink-2,#b8cddd);font-size:14px;font-weight:650;font-stretch:80%;text-transform:uppercase;letter-spacing:.07em;padding:10px 14px 12px;border-bottom:3px solid transparent;cursor:pointer}.ds-tabs button:hover{color:var(--collar-ink,#f2f6f8)}.ds-tabs button[aria-pressed=true]{color:var(--collar-ink,#f2f6f8);border-bottom-color:#e6d58a}.ds-tabs button:focus-visible{outline:2px solid #e6d58a;outline-offset:-2px}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Square hairline panel with a condensed-caps header.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-h\"><h2>Antar wilayah · Cabai Merah Keriting</h2><span>per 7 Nov 2026</span></div><p>Isi panel.</p></section>",
      "css": ".ds-panel{font-family:\"Archivo Variable\",system-ui,sans-serif;background:var(--panel,#fff);color:var(--ink,#1b2326);border:1px solid var(--rule,#d6dbd3)}.ds-panel-h{display:flex;justify-content:space-between;gap:8px 16px;padding:12px 16px;border-bottom:1px solid var(--rule,#d6dbd3)}.ds-panel-h h2{margin:0;font-size:13px;font-weight:650;font-stretch:75%;text-transform:uppercase;letter-spacing:.08em}.ds-panel-h span{font-size:13px;color:var(--ink-2,#4b5759)}.ds-panel p{margin:0;padding:12px 16px}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip-filter",
      "description": "Category tabs; active inverts to ink.",
      "html": "<div class=\"ds-chips\"><button aria-pressed=\"true\">Semua</button><button aria-pressed=\"false\">Bumbu</button><button aria-pressed=\"false\">Ikan</button></div>",
      "css": ".ds-chips{display:flex;gap:6px}.ds-chips button{font-family:\"Archivo Variable\",system-ui,sans-serif;font-size:14px;font-weight:500;color:var(--ink,#1b2326);border:1px solid var(--rule,#d6dbd3);background:transparent;padding:6px 12px;border-radius:0;cursor:pointer}.ds-chips button:hover{border-color:var(--rule-strong,#1b2326)}.ds-chips button[aria-pressed=true]{background:var(--ink,#1b2326);color:var(--panel,#fff);border-color:var(--ink,#1b2326)}.ds-chips button:focus-visible{outline:2px solid var(--focus,#a87000);outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "button",
      "refersTo": "segmented",
      "description": "Joined range buttons for 7/30/90 hari.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"false\">7 hari</button><button aria-pressed=\"true\">30 hari</button><button aria-pressed=\"false\">90 hari</button></div>",
      "css": ".ds-seg{display:inline-flex}.ds-seg button{font-family:\"Archivo Variable\",system-ui,sans-serif;font-size:14px;color:var(--ink,#1b2326);border:1px solid var(--rule-strong,#1b2326);background:var(--panel,#fff);padding:5px 12px;margin-left:-1px;border-radius:0;cursor:pointer}.ds-seg button[aria-pressed=true]{background:var(--ink,#1b2326);color:var(--panel,#fff)}.ds-seg button:focus-visible{outline:2px solid var(--focus,#a87000);outline-offset:2px}"
    },
    {
      "name": "Select",
      "kind": "input",
      "refersTo": "select",
      "description": "Square select with a gradient-drawn chevron.",
      "html": "<select class=\"ds-select\"><option>Cabai Merah Keriting</option><option>Bawang Merah</option></select>",
      "css": ".ds-select{font-family:\"Archivo Variable\",system-ui,sans-serif;font-size:14px;color:var(--ink,#1b2326);background-color:var(--panel,#fff);border:1px solid var(--rule-strong,#1b2326);border-radius:0;padding:6px 30px 6px 10px;appearance:none;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,currentColor 50%),linear-gradient(135deg,currentColor 50%,transparent 50%);background-position:right 14px center,right 9px center;background-size:5px 5px;background-repeat:no-repeat}.ds-select:focus-visible{outline:2px solid var(--focus,#a87000);outline-offset:2px}"
    },
    {
      "name": "Spike Tag",
      "kind": "chip",
      "refersTo": "spike-tag",
      "description": "Red block flag for a 7-day rise above 10%.",
      "html": "<span class=\"ds-spike\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" style=\"vertical-align:-2px\"><path d=\"M8 13V3M3.5 7.5 8 3l4.5 4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\"/></svg>Lonjakan</span>",
      "css": ".ds-spike{font-family:\"Archivo Variable\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:4px;background:var(--spike-bg,#b3302a);color:#fff;font-size:12px;font-weight:700;font-stretch:80%;text-transform:uppercase;letter-spacing:.08em;padding:3px 8px 3px 6px}"
    },
    {
      "name": "Price Row",
      "kind": "custom",
      "refersTo": "table-cell",
      "description": "Commodity table rows with arrow-plus-colour change and a no-data cell.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Komoditas</th><th class=\"n\">Harga</th><th class=\"n\">7 hari</th></tr></thead><tbody><tr class=\"sel\"><th>Cabai Merah Keriting</th><td class=\"n\">Rp 60.435<span class=\"u\">/kg</span></td><td class=\"n up\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" style=\"vertical-align:-2px\"><path d=\"M8 13V3M3.5 7.5 8 3l4.5 4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\"/></svg>+10,1%</td></tr><tr><th>Daging Ayam Ras</th><td class=\"n\">Rp 35.857<span class=\"u\">/kg</span></td><td class=\"n dn\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" style=\"vertical-align:-2px\"><path d=\"M8 3v10M3.5 8.5 8 13l4.5-4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\"/></svg>−2,7%</td></tr><tr><th>Ikan Kembung</th><td class=\"n\"><i>tidak ada data</i></td><td class=\"n\">–</td></tr></tbody></table>",
      "css": ".ds-table{font-family:\"Archivo Variable\",system-ui,sans-serif;border-collapse:collapse;width:100%;font-size:15px;font-variant-numeric:tabular-nums;color:var(--ink,#1b2326);background:var(--panel,#fff)}.ds-table thead th{text-align:left;font-size:11px;font-weight:650;font-stretch:75%;text-transform:uppercase;letter-spacing:.08em;color:var(--ink-2,#4b5759);padding:12px 16px 8px;border-bottom:2px solid var(--rule-strong,#1b2326)}.ds-table tbody th{text-align:left;font-weight:400}.ds-table tbody th,.ds-table td{padding:10px 16px;border-bottom:1px solid var(--rule,#d6dbd3)}.ds-table .n{text-align:right}.ds-table .u{color:var(--ink-2,#4b5759);font-size:13px}.ds-table i{color:var(--ink-2,#4b5759);font-size:14px}.ds-table .up{color:var(--up,#b8322a);font-weight:650}.ds-table .dn{color:var(--down,#1d64a8);font-weight:650}.ds-table tbody tr{cursor:pointer}.ds-table tbody tr:hover>*{background:var(--row-hover,#eff1ec)}.ds-table tbody tr.sel>*{background:var(--row-sel,#e3eaf0)}.ds-table tr.sel th{font-weight:700}"
